color.palette.vscode.link = #3794FF
color.palette.vscode.find = #515C6A
color.palette.vscode.find.active = #613214
color.palette.vscode.highlight = #2A3F5F
color.palette.vscode.find.subtle = #3D4652
color.palette.vscode.find.active.subtle = #47301F
color.palette.vscode.highlight.subtle = #263247
color.palette.vscode.warning = #B59B00
color.palette.vscode.error = #D16969
color.palette.vscode.success = #6A9955
color.palette.vscode.tooltip.bg = #252526
color.palette.vscode.tooltip.fg = #CCCCCC
color.palette.vscode.keyword = #569CD6
color.palette.vscode.type = #4EC9B0
color.palette.vscode.function = #DCDCAA
color.palette.vscode.symbol.function = #C9C99A
color.palette.vscode.variable = #9CDCFE
color.palette.vscode.constant = #B5CEA8
color.palette.vscode.string = #CE9178
color.palette.vscode.comment = #6A9955
color.palette.vscode.operator = #C586C0
color.palette.vscode.orange = #D7BA7D
color.palette.vscode.line = #282828
color.palette.vscode.line.subtle = #242424
color.palette.vscode.marker.yellow = #8A7500
color.palette.vscode.marker.blue = #24507A
color.palette.vscode.marker.cyan = #2A6F68
color.palette.vscode.marker.green = #4F7D5A
color.palette.vscode.marker.red = #8A3A3A
color.palette.vscode.marker.orange = #8A6230
color.palette.vscode.marker.purple = #7A5F7E
color.palette.vscode.diff.add = #203826
color.palette.vscode.diff.change = #1D334A
color.palette.vscode.diff.remove = #3F2424
