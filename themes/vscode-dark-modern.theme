name = VS Code Dark Modern
lookAndFeel = Flat Dark
useDarkDefaults = true

# VS Code Dark Modern palette
color.palette.vscode.editor = #1E1E1E
color.palette.vscode.panel = #252526
color.palette.vscode.panel.alt = #2D2D30
color.palette.vscode.side = #252526
color.palette.vscode.chrome = #202020
color.palette.vscode.chrome.hover = #2A2A2A
color.palette.vscode.input = #3C3C3C
color.palette.vscode.border = #303030
color.palette.vscode.border.subtle = #262626
color.palette.vscode.border.faint = #222222
color.palette.vscode.fg = #D4D4D4
color.palette.vscode.fg.muted = #A0A0A0
color.palette.vscode.disabled = #6A6A6A
color.palette.vscode.flow.inactive = #505050
color.palette.vscode.flow.active = #828282
color.palette.vscode.flow.selected = #7FA887
