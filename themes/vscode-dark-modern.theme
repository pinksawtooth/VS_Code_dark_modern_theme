# System colors used by Swing/FlatLaf and Ghidra controls
[color]system.color.bg.control = color.palette.vscode.panel
[color]system.color.fg.control = color.palette.vscode.fg
[color]system.color.bg.view = color.palette.vscode.editor
[color]system.color.fg.view = color.palette.vscode.fg
[color]system.color.bg.selected.view = color.palette.vscode.selection
[color]system.color.fg.selected.view = color.palette.vscode.selection.fg
[color]system.color.bg.border = color.palette.vscode.border.subtle
[color]system.color.bg.tooltip = color.palette.vscode.tooltip.bg
[color]system.color.fg.tooltip = color.palette.vscode.tooltip.fg
[color]system.color.fg.disabled = color.palette.vscode.disabled

# Fonts: VS Code on macOS uses the system UI face and Menlo-like editor text.
font.vscode.ui = Dialog-plain-12
font.vscode.editor = Menlo-plain-13
[font]system.font.control = font.vscode.ui
[font]system.font.view = font.vscode.ui
[font]system.font.menu = font.vscode.ui
[laf.font]TextArea.font = font.vscode.editor
[laf.font]PasswordField.font = font.vscode.editor
font.standard = font.vscode.ui
font.standard.bold = font.standard[bold]
font.monospaced = font.vscode.editor
font.table.base = font.standard
font.table.fixed.width = font.monospaced
font.table.header.number = font.standard[bold]
font.input.hint = font.monospaced[10]
font.listing.base = font.monospaced
font.listing.base.hidden.field = font.listing.base[italic]
font.listing.header = font.standard[11]
font.decompiler = font.monospaced
font.decompiler.pcode.dfg = font.graphdisplay.default
font.byteviewer = font.monospaced
font.byteviewer.header = font.standard[11]
font.byteviewer.status = font.standard[11]
font.bytepatterns.table = font.monospaced[16]
font.debugger.sleigh = font.monospaced
font.debugger.object.tree.renderer = font.standard[11]
font.plugin.console = font.monospaced
