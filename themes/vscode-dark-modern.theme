font.plugin.assembly.dual.text.field = font.monospaced
font.plugin.function.text.editor = font.monospaced[18]
font.plugin.instruction.table.renderer = font.monospaced[14]
font.plugin.instruction.info = font.monospaced[14]
font.plugin.programgraph = font.graphdisplay.default
font.plugin.terminal = font.monospaced[bold]
font.plugin.terminal.italic = font.plugin.terminal[italic]
font.plugin.terminal.fraktur = font.plugin.terminal
font.plugin.terminal.bright = font.plugin.terminal[bold]
font.plugin.terminal.bright.italic = font.plugin.terminal.bright[italic]
font.plugin.terminal.bright.fraktur = font.plugin.terminal.bright
font.plugin.terminal.dim = font.plugin.terminal[plain]
font.plugin.terminal.dim.italic = font.plugin.terminal.dim[italic]
font.plugin.terminal.dim.fraktur = font.plugin.terminal.dim
font.plugin.terminal.completion.list = font.standard
font.plugin.window.location = font.monospaced[40]
font.plugin.entropy.label.knot = font.standard[bold]
font.plugin.strings.buttons = font.standard[10]
font.plugin.tabs = font.standard[11]
font.plugin.tabs.list = font.standard[bold][9]
font.plugin.tips = font.standard
font.plugin.tips.label = font.plugin.tips[bold]
font.panel.details = font.standard
font.panel.details.monospaced = font.monospaced[bold]
font.pluginpanel.name = font.standard[18]
font.help.about = font.monospaced
font.keybindings.status = font.standard[11]
font.task.monitor.label.message = font.standard[10]
font.task.progress.label.message = font.standard
font.task.viewer = font.standard[bold][36]
font.user.agreement = font.standard[italic][22]
font.print = font.standard[10]
font.splash.infopanel = font.standard[bold][14]
font.splash.header.default = font.standard[bold][35]
font.splash.status = font.standard[bold]
font.glasspane.message = font.standard[bold][24]
font.graphdisplay.default = font.standard[bold][18]
font.graph.component.message = font.standard[bold][italic][18]
font.visualgraph.view.label.message = font.standard[22]
font.widget.tabs.selected = font.standard
font.widget.tabs = font.standard
font.widget.tabs.list = font.standard[bold][11]
font.wizard.border.title = font.standard[10]

